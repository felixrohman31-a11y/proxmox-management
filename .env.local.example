# ProxCenter konfigurasi aplikasi (salin jadi .env.local)
# Secret untuk signing session admin (opsional, min 16 karakter).
# Jika kosong, dipakai secret acak yang disimpan di data/.secret
APP_SECRET=
# Kredensial login panel ProxCenter (WAJIB diganti untuk produksi)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
